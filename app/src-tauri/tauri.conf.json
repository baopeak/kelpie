{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kelpie",
  "version": "0.1.5",
  "identifier": "dev.kelpie.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1427",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Kelpie",
        "width": 1480,
        "height": 920,
        "minWidth": 760,
        "minHeight": 480,
        "backgroundColor": "#10131c",
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "publisher": "Kelpie",
    "copyright": "Copyright (c) 2026 baopeak",
    "category": "DeveloperTool",
    "homepage": "https://github.com/baopeak/kelpie",
    "shortDescription": "Herd every coding agent.",
    "longDescription": "A desktop workbench for running many coding-agent CLIs (Claude Code, Codex, Gemini and more) and shells across many projects at once.",
    "targets": [
      "nsis",
      "dmg",
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./installer/hooks.nsh",
        "installerIcon": "icons/icon.ico",
        "headerImage": "installer/nsis-header.bmp",
        "sidebarImage": "installer/nsis-sidebar.bmp"
      }
    },
    "macOS": {
      "minimumSystemVersion": "12.0",
      "dmg": {
        "background": "installer/dmg-background.png",
        "windowSize": { "width": 660, "height": 400 },
        "appPosition": { "x": 180, "y": 220 },
        "applicationFolderPosition": { "x": 480, "y": 220 }
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxN0M2MzZGMzM4MDlBQjcKUldTM21vQXpiMk44c2NpUW5ZSUdhamU1Y0ZpTUIzU09NVXF2YXJUYUVYY1RsMW00Q3FGTldIWmQK",
      "endpoints": [
        "https://github.com/baopeak/kelpie/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
